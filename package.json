{
  "name": "@vakao-ui/socket-system",
  "version": "0.0.2",
  "description": "Lightweight, type-safe socket system based on socket.io-client (no framework)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run build",
    "pack": "pnpm pack",
    "publish:public": "pnpm publish --access public --no-git-checks",
    "publish:dry": "pnpm publish --access public --dry-run --no-git-checks"
  },
  "dependencies": {
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "socket.io",
    "websocket",
    "typescript",
    "chat",
    "reconnect"
  ]
}
